# Fixture mode needs no variables. Live Snowflake mode (optional, read-only):
# Option 1: reuse a named connection from ~/.snowflake/connections.toml (recommended; no secrets here)
SNOWFLAKE_CONNECTION_NAME=
# Option 2: explicit account/user; password optional (defaults to externalbrowser SSO)
FF_MODE=fixture
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:2b
OLLAMA_TIMEOUT_SECONDS=30
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_AUTHENTICATOR=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=SNOWFLAKE_PUBLIC_DATA_FREE
SNOWFLAKE_SCHEMA=PUBLIC_DATA_FREE
